{
  "name": "otp-authenticator",
  "version": "1.0.0",
  "description": "Desktop TOTP/HOTP authenticator with export import for Mac, Windows, and Linux",
  "main": "src/main.js",
  "author": "OTP Authenticator",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/parser.test.js && node test/totp.test.js && node test/importer.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.otpauthenticator.app",
    "productName": "OTP Authenticator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
